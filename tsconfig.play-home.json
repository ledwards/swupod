{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@purrgil/ui/*": [
        "./vendor/purrgil-ui/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "play-home",
    "vendor/purrgil-ui/src"
  ]
}
